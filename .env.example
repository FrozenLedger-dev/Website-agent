# Copy to .env.local and fill in. .env.local is gitignored — never commit secrets.

# ---- Data layer -------------------------------------------------------------
# Local development (docker compose up -d mongo). Single-node replica set.
MONGODB_URI=mongodb://localhost:27018/statxai?replicaSet=rs0
MONGODB_DB=statxai

# Hosted (Atlas). Note: the database name goes in the PATH, before the query
# string, and w=majority is required for the read-your-own-writes guarantees the
# job engine relies on.
# MONGODB_URI=mongodb+srv://statxai:PASSWORD@cluster0.jcyfsbt.mongodb.net/statxai?retryWrites=true&w=majority&appName=Cluster0

# ---- Workspaces -------------------------------------------------------------
# Root directory for per-project Git repositories (generated website source).
WORKSPACES_ROOT=./workspaces

# Phase 5g-1's disposable validation workspace root — a real directory, never
# the canonical WORKSPACES_ROOT above. Only read when the console resolves
# FRONTEND_BACKEND_EXECUTION_MODE to job_lifecycle; legacy_direct never needs
# it, so leaving this unset is fine for a legacy_direct/rollback deployment.
VALIDATION_WORKSPACES_ROOT=./validation-workspaces

# ---- Frontend/backend build execution (Phase 5l) -----------------------------
# The console's own production default is job_lifecycle when this is unset.
# Set to legacy_direct to roll back the console's build path without a code
# change. Any other value fails the console's startup rather than silently
# falling back. runProject's own internal default (every other caller) stays
# legacy_direct regardless of this variable.
# FRONTEND_BACKEND_EXECUTION_MODE=job_lifecycle

# ---- Console operator authentication (Phase 5o) ------------------------------
# The console holds the production website-generation entrypoint, so every one
# of its pages and API routes requires an authenticated operator. HTTP Basic:
# the browser prompts once and holds the credential itself, so nothing here is
# ever shipped to page JavaScript. Server-side only — never NEXT_PUBLIC_*.
#
# Both are REQUIRED. Missing, empty or whitespace-only fails closed: the
# console refuses every request with 503 rather than serving one anonymously.
# There is no value, in any environment, that disables authentication. The
# user id may not contain a colon (RFC 7617 splits `user:password` on it).
#
# Generate the password with something like `openssl rand -base64 24` and keep
# it in .env.local, which is gitignored.
CONSOLE_OPERATOR_USER=operator
CONSOLE_OPERATOR_PASSWORD=

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- Models ----------------------------------------------------------------
# Sol, Terra and Luna are orchestration tiers, not model names. Each maps to a
# model below; override any of them to change the stack without touching code.
OPENAI_API_KEY=sk-proj-...
# MODEL_SOL=gpt-5.6-sol
# MODEL_TERRA=gpt-5.6-terra
# MODEL_LUNA=gpt-5.6-luna
